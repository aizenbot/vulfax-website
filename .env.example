# Copy to .env.local for local development, or set these in your Vercel project.
# Every variable is optional: the site builds and runs without any of them.

# Public URL of the site — used for canonical links, hreflang, sitemap and Open Graph.
# Default: http://localhost:3000
NEXT_PUBLIC_SITE_URL=

# PLACEHOLDER — public contact inbox. When set:
#   - it is shown in the Contact section and footer
#   - the contact form falls back to opening the visitor's email app (mailto:)
# Leave empty until a real, monitored inbox exists.
NEXT_PUBLIC_CONTACT_EMAIL=

# Server-side email delivery for the contact form (via the Resend REST API).
# Both RESEND_API_KEY and CONTACT_TO_EMAIL must be set to enable POST /api/contact;
# otherwise the endpoint returns 501 and the form never claims a message was sent.
# These are server-only secrets: never prefix them with NEXT_PUBLIC_.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
# Optional verified sender, e.g. "VULFAX <hello@your-domain.com>".
CONTACT_FROM_EMAIL=
